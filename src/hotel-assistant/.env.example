# 环境变量模板：复制为 .env 后填写真实值（.env 已被 .gitignore 排除，切勿提交）
# 应用启动时由 app.py 顶部零依赖加载器读取，不依赖 python-dotenv

# —— 大模型（OpenAI 兼容接口；示例为阿里云百炼 / 千问）——
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-dashscope-key
LLM_MODEL=qwen-plus

# —— 向量模型（与 LLM 可分别指向不同服务）——
# 留空时自动降级为离线稳定哈希向量（256 维），检索仍可用但语义精度下降
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-your-dashscope-key
EMBED_MODEL=text-embedding-v3

# —— 登录签名密钥（生产环境必须替换为随机长串）——
JWT_SECRET=change-me-to-a-random-string

# —— 可选：服务监听地址 ——
# HOST=127.0.0.1
# PORT=8000
