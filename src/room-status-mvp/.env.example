# 复制为 .env 后填写真实值（.env 已被 .gitignore 排除，切勿提交）
# 不带这项也能跑：助手会退化为规则模式，房态与闸门功能完全可用

# —— 大模型（OpenAI 兼容接口；示例为阿里云百炼 / 千问）——
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=qwen-plus
LLM_TIMEOUT=45

# —— 登录签名密钥（生产必须换成 32 位以上随机串）——
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# —— 服务 ——
HOST=127.0.0.1
PORT=8100
HOTEL_NAME=山海旅居
